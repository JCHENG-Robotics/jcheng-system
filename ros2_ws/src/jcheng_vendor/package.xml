<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jcheng_vendor</name>
  <version>0.1.0</version>
  <description>Supervised vendor hardware runtime for M5.2 single-joint and gripper motion</description>
  <maintainer email="chengkewei77@gmail.com">JerichoCheng</maintainer>
  <license>Proprietary (license review pending; no LICENSE file)</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>jcheng_interfaces</exec_depend>
  <exec_depend>jcheng_system_core</exec_depend>
  <exec_depend>jcheng_hardware</exec_depend>
  <exec_depend>jcheng_runtime</exec_depend>
  <exec_depend>servo_controller_msgs</exec_depend>
  <exec_depend>ros_robot_controller_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
